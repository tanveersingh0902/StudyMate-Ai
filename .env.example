# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose your LLM provider: "groq" or "gemini"
LLM_PROVIDER=groq

# ── Groq (GPT-OSS models — OpenAI open-weight on Groq LPUs) ──────────────────
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Options: openai/gpt-oss-120b (flagship, ~500 t/s) | openai/gpt-oss-20b (faster, ~1000 t/s)
GROQ_MODEL=openai/gpt-oss-120b

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Options: gemini-3.7-flash | gemini-3.6-flash | gemini-3.5-flash
GEMINI_MODEL=gemini-3.7-flash

# ── Shared LLM Settings ───────────────────────────────────────────────────────
TEMPERATURE=0.1
MAX_TOKENS=2048

# ── Document Processing ───────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_RETRIEVAL_DOCS=5

# ── Vector Store ──────────────────────────────────────────────────────────────
VECTOR_STORE_PATH=./vector_store

# ── Agent Control ─────────────────────────────────────────────────────────────
MAX_ITERATIONS=3
